# ============================================================================
#  sdkconfig.defaults - ESP-IDF-Grundeinstellungen fuer OrcaOne
# ----------------------------------------------------------------------------
#  Diese Datei legt die WICHTIGEN Voreinstellungen fest und gehoert ins Repo.
#  Die tatsaechliche Konfigurationsdatei "sdkconfig" wird daraus beim Build
#  erzeugt und ist NICHT im Repo (jeder Rechner erzeugt sie selbst).
#  Aendern per "idf.py menuconfig" oder direkt hier.
# ============================================================================

# Nach dem Boot automatisch Arduinos setup()/loop() starten (src/main.cpp).
# OHNE diese Zeile laeuft der Arduino-Code nicht.
CONFIG_AUTOSTART_ARDUINO=y

# Arduino erwartet 1000 Hz Tickrate -> millis()/delay() in Millisekunden genau.
CONFIG_FREERTOS_HZ=1000

# Groesserer Stack fuer die Arduino-Loop-Task (Webserver + Bibliotheken
# brauchen Platz; Standard ist oft zu klein und fuehrt zu Abstuerzen).
CONFIG_ARDUINO_LOOP_STACK_SIZE=16384

# Das verwendete OLED nutzt den SH1106-Controller.
CONFIG_U8G2_DISPLAY_DRIVER_SH1106=y

# Das verwendete ESP32-Board besitzt 4 MB Flash; Image-Header passend setzen.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# Das Firmware-Image ist groesser als 1 MiB. Die grosse Einzel-App-Partition
# bietet 1,5 MiB und benoetigt keine OTA-Slots.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# FatFs: lange Dateinamen erlauben. Ohne diese Zeilen gilt nur 8.3 (max. 8
# Zeichen Name + 3 Endung) -> der Speicher-Dienst scheitert, weil Dateinamen
# wie /nfc/<16-stellige-Kartennummer>.json zu lang sind (f_open -> FR_INVALID_NAME).
# LFN im Heap (statt Stack) spart Stackspeicher der Arduino-Loop-Task.
# Hinweis: Greift nur bei NEU erzeugter sdkconfig. Eine bereits vorhandene
# sdkconfig vorher loeschen oder "idf.py reconfigure" nach dem Entfernen der
# alten CONFIG_FATFS_LFN_*-Zeilen ausfuehren.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
